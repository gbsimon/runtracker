# Postgres. Local dev runs `docker compose up -d`, which publishes the
# container's 5432 on host port 5433.
DATABASE_URL=postgres://runtracker:runtracker@localhost:5433/runtracker

# Shared secret for the Health Auto Export capture endpoint. Set it as the
# `x-ingest-token` header in the Health Auto Export app.
# Per-user ingest tokens replace this in Phase 3.
# Generate with: openssl rand -hex 24
INGEST_TOKEN=

# Phase 1 — Auth.js magic links via Resend.
# AUTH_SECRET signs the session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET=
# AUTH_URL is optional locally (the host header is used) but REQUIRED in
# production: Auth.js only trusts the incoming Host header when AUTH_URL (or
# AUTH_TRUST_HOST) is set, and every request 500s with UntrustedHost without
# it. Set it to the public origin, e.g. https://runtracker.up.railway.app.
AUTH_URL=
# With RESEND_API_KEY unset, magic links are printed to the server log
# (`[auth] magic link for ...`) instead of being emailed. That is the local
# dev flow; in production, set it.
RESEND_API_KEY=
# Sender for magic links. Defaults to "RunTracker <login@resend.dev>"
# (Resend's test domain, which only delivers to your own Resend account
# address). Point it at a verified domain for real users.
AUTH_EMAIL_FROM=
# The account seeded as `owner` by `pnpm db:seed-owner`. Only the owner can
# create invites.
OWNER_EMAIL=simon@gauthierboudreau.me

# Phase 2 — server-side AI coach. One key for everyone; the browser never
# sees it (v1 asked each runner to paste their own).
ANTHROPIC_API_KEY=
# Per-user daily token budget (input + output, cache tokens included).
# Over it, the coach answers in-chat that the budget is spent instead of
# calling the API. Unset or non-numeric means 300000.
AI_DAILY_TOKEN_LIMIT=300000
